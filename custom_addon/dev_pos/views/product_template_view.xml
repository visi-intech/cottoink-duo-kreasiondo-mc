<odoo>
  <data>

    <!-- Form view utama -->
    <record id="view_product_inherit_custom_form" model="ir.ui.view">
      <field name="name">product.template.form</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='categ_id']" position="after">
            <field name="vit_sub_div" readonly="1"/>
            <field name="vit_item_kel" readonly="1"/>
            <field name="vit_item_type" readonly="1"/>
            <field name="brand" readonly="1"/>
        </xpath>
        
        <!-- Tambahkan field baru setelah product_tag_ids -->
        <xpath expr="//field[@name='product_tag_ids']" position="after">
            <field name="is_integrated"/>
            <field name="vit_is_discount"/>
            <field name="index_store" widget="many2many_tags"/>
        </xpath>
      
        <field name="index_store" position="attributes">
          <attribute name="force_save">1</attribute>
        </field>
        
        <!-- Tab Merchandise Category (ikut tampil di form product.product,
             karena product_normal_form_view turunan dari form ini) -->
        <xpath expr="//notebook" position="inside">
            <page string="Merchandise Category" name="merchandise_category">
                <group>
                    <group>
                        <field name="vit_merchandise_category_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <group invisible="not vit_merchandise_category_id">
                    <group string="Artikel">
                        <field name="u_varc"/>
                        <field name="u_vszr"/>
                        <field name="u_vmcc"/>
                        <field name="u_vifc"/>
                        <field name="u_vifn"/>
                        <field name="u_vstc"/>
                        <field name="u_vstn"/>
                    </group>
                    <group string="Category &amp; Brand">
                        <field name="u_vctc"/>
                        <field name="u_vctn"/>
                        <field name="u_vscc"/>
                        <field name="u_vscn"/>
                        <field name="u_vbrc"/>
                        <field name="u_vbrn"/>
                        <field name="u_vsbc"/>
                        <field name="u_vsbn"/>
                    </group>
                    <group string="Color, Size &amp; Label">
                        <field name="u_vcrc"/>
                        <field name="u_vcrn"/>
                        <field name="u_vszc"/>
                        <field name="u_vszn"/>
                        <field name="u_vlbc"/>
                        <field name="u_vlbn"/>
                    </group>
                    <group string="Period &amp; Collection">
                        <field name="u_vwkc"/>
                        <field name="u_vwkn"/>
                        <field name="u_vqtc"/>
                        <field name="u_vqtn"/>
                        <field name="u_vctn_collection"/>
                    </group>
                </group>
            </page>
        </xpath>

        <xpath expr="//page[@name='invoicing']" position="after">
            <page string="Barcodes">
                <field name="multi_barcode_ids">
                    <tree editable="bottom">
                        <field name="barcode"/>
                    </tree>
                </field>
            </page>
        </xpath>
      </field>
    </record>

  </data>
</odoo>